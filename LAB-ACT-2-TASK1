#include <stdio.h>

int main () {

    int total_score;
    int max_score;

    printf("================================\n");
    printf("TASK 1: PERCENTAGE CALCULATOR\n");
    printf("================================\n");

    printf("\nEnter Total Score : ");  //KUNWARE NAKUHA NIYONG SCORE 50
    scanf("%d", &total_score);
    
    printf("Enter Max Score   : "); //KUNG UP TO ILAN YUNG EXAM SO IF 60 Items THEN MAX SCORE IS 60
    scanf("%d", &max_score);

    float percentage;
    percentage = (float)total_score / (float)max_score * 100;

    printf("\nPERCENTAGE        : %.2f%%\n", percentage);

    return 0;
}
